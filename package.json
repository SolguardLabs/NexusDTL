{
    "name": "nexus-dtl",
    "version": "1.0.0",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "test": "node --test tests/node/*.test.js",
        "test:rust": "cargo test --locked",
        "test:all": "cargo test --locked && node --test tests/node/*.test.js",
        "ci": "bash scripts/ci.sh",
        "build": "node scripts/check-js.mjs",
        "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore \"**/*.{js,json,md,yml,yaml}\"",
        "fmt:check": "prettier --check --config .prettierrc --ignore-path .prettierignore \"**/*.{js,json,md,yml,yaml}\""
    },
    "devDependencies": {
        "prettier": "^3.8.3"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
