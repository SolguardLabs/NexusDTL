{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Rust: fmt check",
            "type": "shell",
            "command": "cargo fmt --all -- --check",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Rust: build",
            "type": "shell",
            "command": "cargo build --locked --all-targets",
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Rust: clippy",
            "type": "shell",
            "command": "cargo clippy --all-targets --all-features --locked -- -D warnings",
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Rust: test",
            "type": "shell",
            "command": "cargo test --locked",
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Node: test",
            "type": "shell",
            "command": "bun test --timeout 30000 ./tests/node",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Node: fmt check",
            "type": "shell",
            "command": "bun run fmt:check",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Protocol: scenario snapshot",
            "type": "shell",
            "command": "cargo run --quiet -- snapshot",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Protocol: scenario routed",
            "type": "shell",
            "command": "cargo run --quiet -- routed",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Protocol: scenario credit",
            "type": "shell",
            "command": "cargo run --quiet -- credit",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Protocol: scenario exit",
            "type": "shell",
            "command": "cargo run --quiet -- exit",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Protocol: tests",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Rust: test",
                "Node: test"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Protocol: ci",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Rust: fmt check",
                "Rust: build",
                "Rust: clippy",
                "Rust: test",
                "Node: fmt check",
                "Node: test"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
